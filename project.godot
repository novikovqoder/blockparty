; Engine configuration file.
; Проект Blockparty — социальный 3D открытый мир в кубическом стиле (см. docs/SPEC.md).

config_version=5

[application]

config/name="Blockparty"
config/description="Социальный 3D открытый мир в кубическом стиле для Steam. MVP."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Log="*res://autoload/log.gd"
EventBus="*res://autoload/event_bus.gd"
Settings="*res://autoload/settings.gd"
Save="*res://autoload/save.gd"
Dev="*res://autoload/dev.gd"
SteamService="*res://autoload/steam_service.gd"
Net="*res://autoload/net.gd"
Session="*res://autoload/session.gd"
Voice="*res://autoload/voice.gd"
Interactions="*res://autoload/interactions.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.ru.translation")
locale/fallback="en"

[input]

; Бинды по таблице раздела 5 SPEC; physical_keycode не зависит от раскладки.
; Геймпад и колёсико камеры — П8 (раздел 15: все бинды переназначаемые).
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_backward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
walk={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
map={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":74), Object(InputEventMouseButton,"button_index":1)]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
hand_hold={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
push_to_talk={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
emote_wheel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
emote_1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
emote_2={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
emote_3={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
emote_4={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":52)]
}
emote_5={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":53)]
}
emote_6={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":54)]
}
player_list={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

[physics]

3d_physics/layer_names/3d_layer_1="world"
3d_physics/layer_names/3d_layer_2="players"
3d_physics/layer_names/3d_layer_3="head_top"

[rendering]

renderer/rendering_method="forward_plus"
