// Мультяшный чёрный контур персонажей (раздел 16 SPEC): обратная оболочка —
// копия меша выдавливается вдоль нормалей и рисуется задними гранями
// (cull_front), чистый чёрный без освещения, без прозрачности.
shader_type spatial;
render_mode unshaded, cull_front;

// Смещение вершин в локальных координатах меша: контур-близнец лежит
// внутри масштабируемого glb-инстанса, поэтому фактическая толщина
// в метрах = thickness × scale модели (модель делит ширину на масштаб).
uniform float thickness : hint_range(0.001, 0.2) = 0.03;

void vertex() {
	VERTEX += NORMAL * thickness;
}

void fragment() {
	ALBEDO = vec3(0.0);
}
