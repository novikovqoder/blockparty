# Базовый класс интерактивных объектов П5 (раздел 9 SPEC): маяки, места
# у костра, сундук, лестница, точка вытягивания. Player ищет ближайший
# узел группы Interactable.GROUP и показывает подсказку клавиши E;
# click/hold определяет hold_time(). Логику подтверждения делает хост
# (раздел 10), узел только отправляет запрос и рисует результат.
# Визуал и логика разделены: подклассы строят модель из примитивов,
# которую позже можно заменить сценой (правило проекта).
class_name Interactable
extends Area3D

## Группа, по которой Player ищет интерактивные узлы.
const GROUP: StringName = &"interactable"

## Радиус, в котором объект доступен с клавиши E, м (переопределяют подклассы).
@export var use_radius: float = 2.0


func _ready() -> void:
	add_to_group(GROUP)
	collision_layer = 0
	collision_mask = 0
	monitoring = false
	monitorable = false


## Ключ подсказки i18n («E — зажечь маяк»); пустая строка — сейчас недоступно
## (переопределяют подклассы; базовый объект всегда «занят»).
func hint_key() -> String:
	return ""


## Сколько секунд держать E для срабатывания, с (0 — однократное нажатие).
## player — тот, кто взаимодействует (тип не Player: классы не ссылаются друг
## на друга циклически — GDScript этого не умеет): время может зависеть
## от Силы персонажа (раздел 16).
func hold_time(_player: Node3D) -> float:
	return 0.0


## Сработало взаимодействие (нажатие или полное удержание).
func use(_player: Node3D) -> void:
	pass
